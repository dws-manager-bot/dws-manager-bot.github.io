# ---------- Discord bot ----------
# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Your alliance server ID (User Settings > Advanced > Developer Mode, then
# right-click the server > Copy Server ID)
GUILD_ID=

# ---------- Discord OAuth2 (backoffice login) ----------
# Same app, OAuth2 tab. Add OAUTH_REDIRECT_URI to that tab's Redirects list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://dws-api.xronocore.qzz.io/auth/callback
FRONTEND_URL=https://pou.actuallyplaying.com

# Discord role NAMES allowed into the backoffice and officer commands.
ADMIN_ROLES=R5,R4

# ---------- Database ----------
# In-cluster: use the node LAN IP, which pg_hba allows from 10.42.0.0/16.
DATABASE_URL=postgresql+asyncpg://dws_manager:CHANGEME@192.168.1.136:5432/dws_manager

# ---------- Security ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12

# Browser origins allowed to call this API.
CORS_ORIGINS=https://pou.actuallyplaying.com,https://dws-manager-bot.github.io,http://localhost:5173

# ---------- Runtime ----------
TIMEZONE=Asia/Seoul
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
